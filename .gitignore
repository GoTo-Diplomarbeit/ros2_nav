# Colcon build directories
/build/
/install/
/log/

# Idea folder
.idea/*
!.idea/codeStyles/
!.idea/runConfigurations/
!.idea/.name

# Python bytecode caches (created automatically when Python runs)
__pycache__/
/weights/

# RTAB-Map maps saved by the sim scripts (~100 MB each, too big for git).
# The 2D maps (.pgm/.yaml) in maps/ stay in git.
/maps/*.db
