<?xml version="1.0"?>
<package format="3">
    <name>goto</name>
    <version>0.0.1</version>
    <description>Go2 mapping and navigation</description>
    <maintainer email="peter.promok07@htl-salzburg.ac.at">Peter Promok</maintainer>
    <maintainer email="kilian.schneider07@htl-salzburg.ac.at">Kilian Schneider</maintainer>
    <maintainer email="micah.labendia07@htl-salzburg.ac.at">Micah Labendia</maintainer>
    <maintainer email="alex.pticek07@htl-salzburg.ac.at">Alex Pticek</maintainer>
    <license>Apache-2.0</license>

    <!-- Packages which are needed for both building and running -->
    <depend>rclpy</depend>
    <depend>geometry_msgs</depend>
    <depend>sensor_msgs</depend>
    <depend>std_msgs</depend>

    <!-- Packages which are only needed for running -->
    <exec_depend>slam_toolbox</exec_depend>
    <exec_depend>nav2_bringup</exec_depend>
    <exec_depend>pointcloud_to_laserscan</exec_depend>
    <exec_depend>rviz2</exec_depend>
    <exec_depend>teleop_twist_keyboard</exec_depend>
    <exec_depend>rtabmap_slam</exec_depend>
    <exec_depend>nav2_msgs</exec_depend>
    <exec_depend>action_msgs</exec_depend>

    <!-- Packages which are only needed for testing -->
    <test_depend>python3-pytest</test_depend>

    <export>
        <build_type>ament_python</build_type>
    </export>
</package>
