<?xml version="1.0" ?>
<sdf version="1.8">
  <!-- School floor for testing autonomous mapping: 26 x 18 m, one floor with a roof (3 m).
       Generated, see the plan in the comment below. Start it with:
         bash scripts/build_run_sim_autonomous_mapping.sh school_floor
       The robot spawns at (0, 0) facing +x, in the middle of the corridor.
       The world keeps the name "default" so Gazebo's internal topics (/world/default/...) stay the same.

       y=9   +________+________+________________+
             | Class A| Class B|    Library     |
       y=1.5 +__[ ]___+__[ ]___+____[ ]_________+
             ========== corridor ==========[ ]  porch, east entrance (x=14)
       y=-1.5+_[ ]____+__[ ]___+_____+__________+
             |Storage |Toilets | Lobby |  Canteen |
       y=-9  +________+________+__[ ]_+__________+   south entrance + porch (x=0)
       x=-12 .. 14
       Doors are 1.0 m (storage 0.8 m, library/canteen 1.4 m, lobby opening 6 m, entrances 2 m).
       Both entrances lead into a closed porch, so the robot can't drive out. Class B's door is ajar. -->
  <world name="default">
    <!-- 1 ms steps, like the simulator's other worlds. 2 ms (500 Hz) saved CPU on the school laptop, but the robot may
         rock, slip or flip with it (suspected, not proven). Gazebo publishes /clock once per step, so 1000 Hz costs more CPU:
         on a weak PC you can try 0.002 and 500 again (step x rate = real_time_factor), but watch the robot's walking. -->
    <physics name="1ms" type="bullet-featherstone">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <!-- No shadows: the roof would make the inside dark, and shadows cost render time. -->
    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.6 0.75 0.9 1</background>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.6 0.6 0.6 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="school_floor">
      <static>true</static>
      <!-- outer walls, porches, corridor walls, room partitions -->
      <link name="walls">
        <collision name="c0"><pose>-6.550 -9.000 1.500 0 0 0.0000</pose><geometry><box><size>11.100 0.200 3.000</size></box></geometry></collision>
        <visual name="v0"><pose>-6.550 -9.000 1.500 0 0 0.0000</pose><geometry><box><size>11.100 0.200 3.000</size></box></geometry><material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
        <collision name="c1"><pose>7.550 -9.000 1.500 0 0 0.0000</pose><geometry><box><size>13.100 0.200 3.000</size></box></geometry></collision>
        <visual name="v1"><pose>7.550 -9.000 1.500 0 0 0.0000</pose><geometry><box><size>13.100 0.200 3.000</size></box></geometry><material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
        <collision name="c2"><pose>1.000 9.000 1.500 0 0 0.0000</pose><geometry><box><size>26.200 0.200 3.000</size></box></geometry></collision>
        <visual name="v2"><pose>1.000 9.000 1.500 0 0 0.0000</pose><geometry><box><size>26.200 0.200 3.000</size></box></geometry><material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
        <collision name="c3"><pose>-12.000 0.000 1.500 0 0 0.0000</pose><geometry><box><size>0.200 18.000 3.000</size></box></geometry></collision>
        <visual name="v3"><pose>-12.000 0.000 1.500 0 0 0.0000</pose><geometry><box><size>0.200 18.000 3.000</size></box></geometry><material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
