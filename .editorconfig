# Editors on Windows will happily save .sh / .py as CRLF, which breaks bash
# scripts with "bad interpreter" and is generally wrong for ROS 2.
# These files must stay LF regardless of which editor or OS touches them.
root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8

[*.py]
indent_style = space
indent_size = 4

[*.sh]
indent_style = space
indent_size = 4
